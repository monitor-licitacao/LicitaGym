# Remoto: copie para supabase/.env.local (nunca commitar)
# Local: use supabase/.env.functions.local (só SYNC_CRON_SECRET)

# CLI (Dashboard → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=sbp_...

SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_REST_URL=https://SEU_PROJECT_REF.supabase.co/rest/v1/
SUPABASE_JWKS_URL=https://SEU_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Dashboard → Settings → API (nomenclatura atual)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Edge Functions leem estes nomes (mapeie publishable → anon, secret → service)
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

SYNC_CRON_SECRET=troque-por-um-segredo-forte

# Local dev:
#   npx supabase start
#   .\scripts\apply-migrations-local.ps1   # se db reset falhar
#   npx supabase functions serve --no-verify-jwt --env-file supabase/.env.functions.local sync-pncp-pca

# Remoto:
#   npx supabase link --project-ref SEU_PROJECT_REF
#   npx supabase db push
#   npx supabase secrets set --env-file supabase/.env.local

# Opcional — catálogo / IRP por órgão (API integração)
# PNCP_INTEGRACAO_TOKEN=
